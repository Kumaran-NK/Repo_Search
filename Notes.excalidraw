      "link": null,
      "locked": false,
      "text": "class Tool(BaseModel):\n  name: str\n        description: str\n                    input_schema: Dict[str, any]\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Tool(BaseModel):\n  name: str\n        description: str\n                    input_schema: Dict[str, any]\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AVHauBoxP6z5LwhaTfD8y",
      "type": "text",
      "x": 2793.198681150164,
      "y": 1630.9424247741695,
      "width": 334.0609130859375,
      "height": 192.49993591058248,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 931632259,
      "version": 99,
      "versionNonce": 1335916717,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769763395182,
      "link": null,
      "locked": false,
      "text": "When you inherit from BaseModel:\n\n✅ Automatically creates __init__\n\n✅ Enforces type validation\n\n✅ Converts data if possible\n\n✅ Raises errors if data is invalid",
      "fontSize": 17.111105414274,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When you inherit from BaseModel:\n\n✅ Automatically creates __init__\n\n✅ Enforces type validation\n\n✅ Converts data if possible\n\n✅ Raises errors if data is invalid",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y3-nXbt9HxVs83-vXC_H6",
      "type": "text",
      "x": 3162.129345212664,
      "y": 1630.9424858093257,
      "width": 281.7998046874999,
      "height": 198.76161772629297,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 1227044163,
      "version": 53,
      "versionNonce": 2139378637,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769763415212,
      "link": null,
      "locked": false,
      "text": "This class is meant to be:\n\nA data container\n\nA schema\n\nA contract\n\nNot behavior, just structure.",
      "fontSize": 17.667699353448274,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This class is meant to be:\n\nA data container\n\nA schema\n\nA contract\n\nNot behavior, just structure.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m5ERklh0n1QEAnvJsHUd5",
      "type": "text",
      "x": 3096.829296384539,
      "y": 1482.142498016357,
      "width": 430.6131184895833,
      "height": 73.39996337890625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 509816205,
      "version": 43,
      "versionNonce": 86509037,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769763464040,
      "link": null,
      "locked": false,
      "text": "name is a field\nIt must be of type str\nThis is type annotation, not assignment.",
      "fontSize": 19.573323567708332,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "name is a field\nIt must be of type str\nThis is type annotation, not assignment.",
