    {
      "id": "tMHCKCfnOKuVoXyh0UWXH",
      "type": "text",
      "x": -1623.706171081185,
      "y": 1710.9752197265625,
      "width": 1247.399169921875,
      "height": 1485,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
