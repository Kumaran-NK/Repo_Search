      "isDeleted": false,
      "boundElements": null,
      "updated": 1769758067903,
      "link": null,
      "locked": false,
      "text": "OS : \nRead environment variables (API keys)\nWork with file paths\nOS-independent code\n\nSYS:\nCommand-line arguments\nModify Python path\nExit program\n\ntyping:\nMakes code readable\nHelps IDEs & linters\nImportant for large projects & AI agents\n\nClaude:\nClient to talk to Claude LLMs\nHandles API requests, auth, responses\n\nPydantic: \nEnforce structured outputs\nValidate inputs\nDefine message schemas\n\n    \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OS : \nRead environment variables (API keys)\nWork with file paths\nOS-independent code\n\nSYS:\nCommand-line arguments\nModify Python path\nExit program\n\ntyping:\nMakes code readable\nHelps IDEs & linters\nImportant for large projects & AI agents\n\nClaude:\nClient to talk to Claude LLMs\nHandles API requests, auth, responses\n\nPydantic: \nEnforce structured outputs\nValidate inputs\nDefine message schemas\n\n    \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
